#!/usr/bin/env bash
#
# Refuses a commit whose authorship looks wrong, and one carrying an
# attribution trailer.
#
# WHAT IT IS FOR
#   Two things go wrong quietly: a commit lands under whatever identity
#   the shell happened to have, and a commit message picks up an
#   attribution trailer.
#   Neither is caught by review, because neither shows up in a diff.
#
# WHAT IT CHECKS
#   By default: that author and committer are set, non-empty, and identical.
#   That is enough to catch a misconfigured shell without naming anybody, so
#   it works for every contributor rather than one.
#
#   To pin a specific identity - useful on a single-author repo - set:
#     git config macrowire.authorName  "Your Name"
#     git config macrowire.authorEmail "you@example.com"
#   Both must be set for the check to apply.
#
# INSTALLING
#   Hooks are not cloned. Copy it in by hand:
#     cp git-hooks/commit-msg .git/hooks/commit-msg
#     chmod +x .git/hooks/commit-msg
#
set -euo pipefail

msg_file="$1"

author_name="$(git config user.name || true)"
author_email="$(git config user.email || true)"
committer_name="${GIT_COMMITTER_NAME:-$author_name}"
committer_email="${GIT_COMMITTER_EMAIL:-$author_email}"

if [[ -z "$author_name" || -z "$author_email" ]]; then
    echo "commit-msg: refusing commit - git identity is not set." >&2
    echo "  git config user.name  \"Your Name\"" >&2
    echo "  git config user.email \"you@example.com\"" >&2
    exit 1
fi

if [[ "$author_email" != "$committer_email" ]]; then
    echo "commit-msg: refusing commit - author and committer disagree." >&2
    echo "  author   : ${author_name} <${author_email}>" >&2
    echo "  committer: ${committer_name} <${committer_email}>" >&2
    echo "  Usually a stale GIT_COMMITTER_* in the environment." >&2
    exit 1
fi

# Optional pin. Only enforced when BOTH are configured, so the hook is
# usable by anyone who clones this without editing it.
expected_name="$(git config macrowire.authorName || true)"
expected_email="$(git config macrowire.authorEmail || true)"
if [[ -n "$expected_name" && -n "$expected_email" ]]; then
    if [[ "$author_name" != "$expected_name" || "$author_email" != "$expected_email" ]]; then
        echo "commit-msg: refusing commit - authorship does not match the pin." >&2
        echo "  expected : ${expected_name} <${expected_email}>" >&2
        echo "  actual   : ${author_name} <${author_email}>" >&2
        echo "  (pin lives in git config macrowire.authorName / macrowire.authorEmail)" >&2
        exit 1
    fi
fi

if grep -qiE '^(co-authored-by|generated with|assisted-by)' "$msg_file"; then
    echo "commit-msg: attribution trailers are not permitted in this repo." >&2
    exit 1
fi

exit 0
