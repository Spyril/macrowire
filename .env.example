# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every value here is read with os.environ[...] and has NO fallback default.
# If a source in sources.yaml interpolates ${NAME} and NAME is unset, the
# config loader raises rather than substituting an empty string.

# Contact address embedded in the outbound User-Agent. RBA is a public
# government server; identify yourself.
MACROWIRE_CONTACT=you@example.com

# Optional override for the SQLite path. Defaults to data/macrowire.db.
# MACROWIRE_DB=/absolute/path/to/macrowire.db

# No API keys are required for step 1. Future keyed sources go here, e.g.
# FRED_API_KEY=
