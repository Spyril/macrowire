# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every value here is read with os.environ[...] and has NO fallback default.
# If a source in sources.yaml interpolates ${NAME} and NAME is unset, the
# config loader raises rather than substituting an empty string.

# REQUIRED. Contact address embedded in the outbound User-Agent. Every
# source here is a public government or exchange server and they expect to
# know who is calling. Config load fails without this rather than letting a
# nameless request go out.
MACROWIRE_CONTACT=you@example.com

# Optional. Identifies the project in the User-Agent. Set this if you fork
# the repo, so your traffic points at yours rather than the original.
# MACROWIRE_PROJECT_URL=https://github.com/you/macrowire

# Optional override for the SQLite path. Defaults to data/macrowire.db.
# MACROWIRE_DB=/absolute/path/to/macrowire.db

# SEC EDGAR requires a User-Agent of the form "Name email" and ENFORCES it -
# anything else is answered with HTTP 403. Not a key, but required, and it
# identifies you to them, so it lives here rather than in tracked config.
SEC_CONTACT=Your Name you@example.com

# No API keys are required yet. Future keyed sources go here, e.g.
# FRED_API_KEY=
