# Secrets
.env
.env.local
*.key
credentials.json

# Local data store (see README: no backfill, history is not re-fetchable)
data/
*.db
*.sqlite

# Data exports. The export directory holds COLLECTED ROWS, not code, and
# the licence that covers this repository does not cover them - see README,
# "Licence". A clone arrives with no data at all and builds its own by
# polling; keeping an export here would have published one publisher's
# material under a code licence that says nothing about it.
export/
*.csv
*.parquet

# Editor scaffolding
.vscode/

# Python
__pycache__/
.ipynb_checkpoints/
venv/
docs/context/
